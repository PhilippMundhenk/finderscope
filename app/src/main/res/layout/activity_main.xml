<?xml version="1.0" encoding="utf-8"?>
<!--
  One screen, two faces. Live: the camera's picture full-bleed on black, controls floating over it
  on gradient scrims like a camera app (top: close, flash, timer, size, settings; bottom: last
  picture, shutter, shots left; zoom pill above the shutter). Not connected: a dark start screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finder_bg">

    <!-- the viewfinder: the picture at its true aspect ratio, centred -->
    <FrameLayout
        android:id="@+id/finder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone">

            <SurfaceView
                android:id="@+id/liveSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/liveImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/live_description"
                android:scaleType="fitXY"
                android:visibility="gone" />

            <org.mundhenk.finderscope.app.AfOverlayView
                android:id="@+id/afOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </FrameLayout>

    <!-- laid over the picture by the code (MainActivity.applyPlan) -->
    <FrameLayout
        android:id="@+id/pictureOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp">

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#AA000000"
            android:shadowRadius="12"
            android:textColor="@color/finder_fg"
            android:textSize="120sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- live: top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/disconnect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/disconnect"
            android:src="@drawable/ic_close"
            app:tint="@color/finder_fg" />

        <TextView
            android:id="@+id/info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/finder_fg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/flash"
            style="@style/Widget.Finderscope.TopChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/flash"
            app:icon="@drawable/ic_flash" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/timer"
            style="@style/Widget.Finderscope.TopChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/timer_off"
            app:icon="@drawable/ic_timer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/size"
            style="@style/Widget.Finderscope.TopChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/size"
            android:text="@string/size" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/finder_fg" />
    </LinearLayout>

    <!-- live: notices, in free space where there is some (placed by the code) -->
    <FrameLayout
        android:id="@+id/noticeArea"
        android:layout_width="0dp"
        android:layout_height="0dp">

    <TextView
        android:id="@+id/notice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/pill"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/finder_fg"
        android:visibility="gone" />
    </FrameLayout>

    <!-- live: the controls (bottom row, or a column on the right in wide windows) -->
    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/zoomPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomOut"
                style="@style/Widget.Finderscope.ZoomButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@string/zoom_out"
                android:text="@string/zoom_out_short" />

            <TextView
                android:id="@+id/zoomLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:gravity="center"
                android:text="0"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zoomIn"
                style="@style/Widget.Finderscope.ZoomButton"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@string/zoom_in"
                android:text="@string/zoom_in_short" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shutterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/lastPicture"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#33FFFFFF"
                android:contentDescription="@string/last_picture"
                android:padding="2dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Finderscope.Circle"
                app:strokeColor="@color/finder_fg"
                app:strokeWidth="2dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <org.mundhenk.finderscope.app.ShutterView
                android:id="@+id/shutter"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="@string/shutter_hint" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shots"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="@color/finder_fg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/shotsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shots_label"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#BBFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- not connected: the start screen -->
    <LinearLayout
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/start_bg"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Finderscope.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="?attr/actionBarSize"
            app:title="" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brand" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/app_name"
                    android:textColor="@color/finder_fg"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/tagline"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/start_muted" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="@string/status_idle"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/finder_fg" />

                <TextView
                    android:id="@+id/statusHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/howto"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/start_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/joinWifi"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/join_wifi"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="30dp"
                    app:icon="@drawable/ic_wifi"
                    app:iconGravity="textStart"
                    app:iconTint="@color/finder_fg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/otherCamera"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/other_camera"
                    android:textColor="@color/finder_fg"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addressToggle"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/connect_by_address"
                    android:textColor="@color/start_muted" />

                <LinearLayout
                    android:id="@+id/addressGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addressLayout"
                        style="@style/Widget.Finderscope.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/address"
                        app:helperText="@string/address_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:textColor="@color/finder_fg" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connect"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/connect"
                        android:textColor="@color/finder_fg"
                        app:cornerRadius="26dp"
                        app:strokeColor="#55FFFFFF" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/demo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/demo"
                    android:textColor="@color/accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/demo_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/start_muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:text="@string/disclaimer"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="#77FFFFFF" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

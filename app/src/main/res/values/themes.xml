<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Finderscope" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/surface</item>
        <!-- the bar above the black brand bar is black too (before Android 15's edge-to-edge) -->
        <!-- edge to edge: each screen's own background shows behind the system bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Widget.Finderscope.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/finder_bg</item>
        <item name="titleTextColor">@color/finder_fg</item>
        <item name="subtitleTextColor">#BBBBBB</item>
        <item name="android:theme">@style/ThemeOverlay.Finderscope.Toolbar</item>
    </style>

    <style name="ThemeOverlay.Finderscope.Toolbar" parent="ThemeOverlay.Material3.Dark">
        <item name="colorControlNormal">@color/finder_fg</item>
        <item name="colorOnSurface">@color/finder_fg</item>
    </style>

    <style name="Widget.Finderscope.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- camera-style controls over the live picture -->
    <style name="Widget.Finderscope.TopChip" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/finder_fg</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="iconTint">@color/finder_fg</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Finderscope.ZoomButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/finder_fg</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="ShapeAppearance.Finderscope.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- outlined text field on the dark start screen -->
    <style name="Widget.Finderscope.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/start_muted</item>
        <item name="helperTextTextColor">@color/start_muted</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- round tonal buttons on the dark viewfinder bar -->
    <style name="Widget.Finderscope.FinderButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="android:textColor">@color/finder_fg</item>
    </style>
    <!-- Settings: a heading in the accent colour above each group, the group in an outlined card -->
    <style name="Finderscope.SettingsHeading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="Finderscope.SettingsCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Finderscope.SettingsHint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Finderscope" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Widget.Finderscope.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/finder_bg</item>
        <item name="titleTextColor">@color/finder_fg</item>
        <item name="subtitleTextColor">#BBBBBB</item>
        <item name="android:theme">@style/ThemeOverlay.Finderscope.Toolbar</item>
    </style>

    <style name="ThemeOverlay.Finderscope.Toolbar" parent="ThemeOverlay.Material3.Dark">
        <item name="colorControlNormal">@color/finder_fg</item>
        <item name="colorOnSurface">@color/finder_fg</item>
    </style>

    <style name="Widget.Finderscope.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
    </style>

    <!-- round tonal buttons on the dark viewfinder bar -->
    <style name="Widget.Finderscope.FinderButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="backgroundTint">#33FFFFFF</item>
        <item name="android:textColor">@color/finder_fg</item>
    </style>
</resources>
